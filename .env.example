# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio injects this at runtime; on Vercel add it in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this app is hosted.
APP_URL="MY_APP_URL"

# SINGLE-DOOR CLOUD DATABASE FOR VERCEL (Pick ONE: Upstash Redis / Vercel KV OR Supabase)
# 1. Recommended (1-click in Vercel Marketplace -> Storage -> Upstash Redis):
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Or Upstash direct env names:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 2. Alternative (Supabase REST table `siops_kv` with columns `id` text primary key, `payload` jsonb):
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: Point secondary/preview frontend links to ONE primary Vercel production URL (single-door API)
VITE_API_BASE_URL=""

# ADMIN DATABASE AUTHENTICATION & SESSION SIGNING (Server-side only, never prefix with VITE_)
# Set ADMIN_PASSCODE in production secrets to enforce an Admin passcode override.
ADMIN_PASSCODE=""
# Random 32+ char secret used to sign Admin and Staff Bearer session tokens.
SESSION_SECRET=""

